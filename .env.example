# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_FREE=100
RATE_LIMIT_PREMIUM=10000

# BullMQ Worker
WORKER_CONCURRENCY=5

# Retry / Backoff (Stage 5)
# Base delay in ms for the first retry. Doubles on each subsequent attempt (exponential).
BACKOFF_BASE_DELAY=1000
BACKOFF_TYPE=exponential


# Logging
LOG_LEVEL=info

# App URL
APP_URL=http://localhost:3000

# Stripe for Premium Tier Upgrade
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_CENTS=50
STRIPE_CURRENCY=usd

