# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_FREE=100
RATE_LIMIT_PREMIUM=10000

# BullMQ
WORKER_CONCURRENCY=5

# Logging
LOG_LEVEL=info

